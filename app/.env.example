# Copy this file to .env.local and fill in what you have.
# Everything is optional: with no keys the app still finds leads from OpenStreetMap
# and checks their websites.

# Google Places API (New). 1,000 free Text Search requests/month on the tier we use.
# Console: https://console.cloud.google.com/ -> enable "Places API (New)" -> Credentials -> API key
GOOGLE_PLACES_API_KEY=

# PageSpeed Insights (mobile speed score). Works without a key at low volume.
# Same Google Cloud project -> enable "PageSpeed Insights API".
# If you reuse the Places key and it's restricted, add "PageSpeed Insights API" to its allowed APIs.
PAGESPEED_API_KEY=

# Web search: used to find websites the map missed and Instagram/Facebook profiles.
# The app uses the first one that's set up and falls back to the next if one fails.
#
# 1) SearXNG: free, unlimited, runs on your own computer (see README "Free web search").
SEARXNG_URL=
# 2) Tavily: 1,000 searches a month free, no credit card. https://app.tavily.com
TAVILY_API_KEY=
# 3) Brave: optional, needs a card on file.
BRAVE_SEARCH_API_KEY=
# 4) DuckDuckGo is always the last fallback: free but may block after many searches.

# Google Maps scraper: LOCAL TESTING ONLY (see README "Google Maps scraper").
# Against Google's terms; the app ignores it in live/production builds.
GMAPS_SCRAPER_URL=

# Instagram (official Meta API, optional). Reads followers, last post and the website in
# the bio for business accounts. See README "Instagram setup". No scraping, no logins.
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Facebook Page search (official). Leave off until Meta approves "Page Public Metadata
# Access" for your app (needs App Review + business verification). Then set to on.
FB_PAGE_SEARCH=off

# Apollo — only the client's own key. Leave blank if you don't have one.
APOLLO_API_KEY=

# Supabase (optional). Without it, results are saved in the .data folder.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for the app. SET THIS before putting the app online: saved searches contain
# business phone numbers and emails, and each search spends your API quota.
# The browser asks for it (any user name works). Leave blank only on your own computer.
APP_PASSWORD=

# Reuse web searches and website checks from earlier searches for up to 7 days (faster).
# off = never reuse, search = reuse web searches only.
LEAD_CACHE=

# REQUIRED for OpenStreetMap: your real email. OpenStreetMap's place lookup blocks
# requests without a real contact (you'll see "Nominatim 403").
CRAWLER_CONTACT=
